{
  // Type-checks select.mjs alone against FeedEntry (src/lib/feed.ts), so a new feed kind
  // fails `npm run check` at each `never` default in select.mjs. Not strict: see #167.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": false,
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [],
    "skipLibCheck": true
  },
  "include": ["select.mjs"]
}
