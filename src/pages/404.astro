---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="There is nothing at this address.">
  <section class="wrap pt-16 md:pt-24 pb-10">
    <p class="label"><b>404</b>Not found</p>
    <h1 class="display text-4xl mt-6 text-orange">Nothing<br />here</h1>
    <p class="mt-8 text-lg max-w-[44ch]">
      There is nothing at this address. The old site had different URLs; everything that mattered now lives under
      Work or Writing.
    </p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a class="btn btn-lime" href="/">Home</a>
      <a class="btn" href="/work/">Work</a>
      <a class="btn" href="/writing/">Writing</a>
    </div>
  </section>
</Base>
