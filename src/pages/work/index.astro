---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { CATEGORY_LABEL } from '../../lib/site';
import { getSmallerBuilds, getWorkSequence } from '../../lib/projects';
import { CATEGORY_ORDER, earliestYear, twoDigit } from '../../lib/work-order';

// Cards show the number the work sequence gives them, so numbers run 01..N in grid order.
// The sequence, the header count and the start year cover full case studies only (isCaseStudy).
const sequence = await getWorkSequence();
// Smaller builds: one compact row each after the last group, no page, no number (ADR 0007).
const smaller = await getSmallerBuilds();
const since = earliestYear(sequence.map((e) => e.project.data.period));
const groups = CATEGORY_ORDER.map((cat) => ({
  cat,
  label: CATEGORY_LABEL[cat]!,
  items: sequence.filter((e) => e.project.data.category === cat),
})).filter((g) => g.items.length);
---

<Base title="Work" description="Case studies: Django platforms for live medical-training events, self-hosted AI, observability, client rebuilds and tooling.">
  <section class="wrap pt-10 md:pt-16">
    <p class="label"><b>{twoDigit(sequence.length)}</b>{" "}projects{since ? `, ${since} to now` : ''}</p>
    <h1 class="display text-4xl mt-5" data-split>Work</h1>
    <p class="mt-6 text-lg text-steel max-w-[52ch]">
      Platforms for a wetlab-education company, rebuilds for small businesses, and the tooling that lets one engineer
      ship them. Private repos say so; public ones link.
    </p>
  </section>

  {
    groups.map((g, gi) => (
      <section class="wrap mt-16 md:mt-24" aria-labelledby={`group-${g.cat}`}>
        <h2 id={`group-${g.cat}`} class="label mb-6">
          <b>{twoDigit(gi + 1)}</b>{" "}
          {g.label}
        </h2>
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
          {g.items.map((e) => (
            <ProjectCard project={e.project} number={e.number} />
          ))}
        </div>
      </section>
    ))
  }

  {
    smaller.length > 0 && (
      <section id="smaller-builds" class="wrap mt-16 md:mt-24" aria-labelledby="group-smaller-builds">
        <h2 id="group-smaller-builds" class="label mb-6">
          <b>{twoDigit(groups.length + 1)}</b>{" "}
          Smaller builds
        </h2>
        <ul class="border-t border-line">
          {smaller.map((p) => (
            <li class="grid gap-3 py-5 border-b border-line" data-smaller-build={p.data.slug}>
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
                <h3 class="text-lg font-semibold">{p.data.title}</h3>
                <span class="ml-auto font-mono text-xs uppercase tracking-[0.12em] text-steel" data-row-end>{p.data.period}</span>
              </div>
              <p class="text-sm leading-relaxed text-steel max-w-[64ch]">{p.data.oneLiner}</p>
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
                <ul class="flex flex-wrap gap-1.5" aria-label="Stack">
                  {p.data.stack.map((s) => (
                    <li class="chip">{s}</li>
                  ))}
                </ul>
                {p.data.visibility === 'private' ? (
                  <span class="ml-auto font-mono text-xs uppercase tracking-[0.12em] text-steel" data-row-end>Private repository</span>
                ) : (
                  p.data.repo && (
                    <a class="link ml-auto inline-block py-2 -my-2 font-mono text-xs uppercase tracking-[0.12em] text-steel" href={p.data.repo} data-row-end>
                      Public repository
                    </a>
                  )
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

