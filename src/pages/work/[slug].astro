---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import { CATEGORY_LABEL } from '../../lib/site';
import { getPublishedPosts } from '../../lib/posts';
import { getVisibleProjects, getWorkSequence } from '../../lib/projects';
import { caseNumber } from '../../lib/work-order';
import { pageOg } from '../../lib/og';
import { DIAGRAMS } from '../../components/diagrams';

export async function getStaticPaths() {
  const projects = await getVisibleProjects();
  return projects.map((project) => ({ params: { slug: project.data.slug }, props: { project } }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
// Letters in the title's longest word: the H1 is sized so that word fits its column (#52).
const longestWord = Math.max(...d.title.split(/\s+/).map((w) => w.length));
const og = pageOg(d.slug, d.title);

// Number and Previous/Next follow the /work/ grid, so the chain walks the groups in order.
const all = await getWorkSequence();
const i = all.findIndex((p) => p.data.slug === d.slug);
const prev = i > 0 ? all[i - 1] : undefined;
const next = i < all.length - 1 ? all[i + 1] : undefined;
const related = (await getPublishedPosts()).filter((p) => p.data.project === d.slug);
const hasBody = (project.body ?? '').trim().length > 0;
const ProjectDiagram = d.diagram ? DIAGRAMS[d.diagram] : undefined;
const hasSections = d.sections.length > 0;
---

<Base title={d.title} description={d.oneLiner} {...og}>
  <article class="wrap pt-10 md:pt-16">
    <header class="case-head">
      <p class="label">
        <b>{caseNumber(i)}</b>{CATEGORY_LABEL[d.category]}<span aria-hidden="true">/</span>{d.period}
      </p>
      <h1 class="display text-4xl case-title mt-5" style={`--longest: ${longestWord}`} data-split>{d.title}</h1>
      <p class="mt-6 text-lg md:text-xl leading-snug max-w-[46ch]">{d.oneLiner}</p>

      <dl class="case-facts">
        <div>
          <dt>Role</dt>
          <dd>{d.role}</dd>
        </div>
        <div>
          <dt>Period</dt>
          <dd>{d.period}</dd>
        </div>
        <div>
          <dt>Code</dt>
          <dd>
            {
              d.visibility === 'private' ? (
                <span>Private repository</span>
              ) : d.repo ? (
                <a class="link" href={d.repo}>GitHub</a>
              ) : (
                <span>Public</span>
              )
            }
            {d.live && (
              <>
                <span aria-hidden="true"> / </span>
                <a class="link" href={d.live}>Live</a>
              </>
            )}
          </dd>
        </div>
      </dl>

      <ul class="case-stack" aria-label="Stack">
        {d.stack.map((s) => <li class="chip chip-strong">{s}</li>)}
      </ul>
    </header>

    <div class="case-grid">
      <section aria-labelledby="features-title">
        <h2 id="features-title" class="label mb-5"><b>What it does</b></h2>
        <ul class="case-features">
          {d.features.map((f) => <li>{f}</li>)}
        </ul>
      </section>

      <aside aria-labelledby="hooks-title">
        <h2 id="hooks-title" class="label mb-5"><b>Worth knowing</b></h2>
        <ul class="case-hooks">
          {d.hooks.map((h) => <li class="case-hook">{h}</li>)}
        </ul>
      </aside>
    </div>

    {
      ProjectDiagram && (
        <figure class="case-diagram">
          <figcaption class="label mb-6">
            <b>How it fits together</b>
          </figcaption>
          <ProjectDiagram />
        </figure>
      )
    }

    {/* The body is the product's story: it comes before the "in depth" sections, and on
        pages that have them it sits under its own rule so it is not read as part of the
        architecture figure above it or the last sub-section (#68). */}
    {
      hasBody && (
        <section
          class:list={['prose prose-site mt-16 md:mt-24', { 'case-intro': hasSections }]}
          aria-label="Notes"
        >
          <Content />
        </section>
      )
    }

    {
      hasSections && (
        <section class="case-sections" aria-labelledby="sections-title">
          <h2 id="sections-title" class="label mb-2">
            <b>What it does</b>in depth
          </h2>
          {d.sections.map((s) => {
            const SectionDiagram = s.diagram ? DIAGRAMS[s.diagram] : undefined;
            return (
              <section id={s.id} class="case-section" aria-labelledby={`${s.id}-title`}>
                <h3 id={`${s.id}-title`} class="display-narrow text-2xl">
                  {s.title}
                </h3>
                {s.origin && <p class="case-origin">{s.origin}</p>}
                <p class="mt-4 max-w-[62ch] text-steel leading-relaxed">{s.summary}</p>
                <ul class="case-features mt-6 max-w-[52rem]">
                  {s.features.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>
                {s.stack.length > 0 && (
                  <ul class="case-stack" aria-label={`${s.title} stack`}>
                    {s.stack.map((t) => (
                      <li class="chip">{t}</li>
                    ))}
                  </ul>
                )}
                {SectionDiagram && (
                  <figure class="case-diagram">
                    <figcaption class="label mb-6">
                      <b>How it fits together</b>
                      {s.title}
                    </figcaption>
                    <SectionDiagram />
                  </figure>
                )}
              </section>
            );
          })}
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="mt-20" aria-labelledby="related-title">
          <h2 id="related-title" class="label mb-4">
            <b>Writing</b>about this project
          </h2>
          <div>
            {related.map((post) => (
              <PostRow post={post} />
            ))}
          </div>
        </section>
      )
    }

    <nav class="case-nav rule" aria-label="More projects">
      {
        prev ? (
          <a href={`/work/${prev.data.slug}/`} class="case-nav-link">
            <span class="label">Previous</span>
            <span class="display-narrow text-xl">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a href={`/work/${next.data.slug}/`} class="case-nav-link text-right items-end">
            <span class="label">Next</span>
            <span class="display-narrow text-xl">{next.data.title}</span>
          </a>
        ) : (
          <a href="/work/" class="case-nav-link text-right items-end">
            <span class="label">Index</span>
            <span class="display-narrow text-xl">All work</span>
          </a>
        )
      }
    </nav>
  </article>
</Base>

<style>
  .case-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 1.5rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 2px solid var(--color-paper);
    max-width: 48rem;
  }
  .case-facts dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-steel);
  }
  .case-facts dd {
    margin: 0.35rem 0 0;
    font-size: var(--text-sm);
  }
  .case-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    max-width: 48rem;
  }
  .case-grid {
    display: grid;
    gap: 3rem;
    margin-top: 4rem;
  }
  @media (min-width: 64rem) {
    .case-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 5rem;
    }
  }
  .case-features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .case-features li {
    position: relative;
    padding: 0.9rem 0 0.9rem 1.5rem;
    border-top: 1px solid var(--color-line);
    line-height: 1.55;
  }
  .case-features li:last-child {
    border-bottom: 1px solid var(--color-line);
  }
  .case-features li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.4rem;
    width: 0.45rem;
    height: 0.45rem;
    background: var(--color-lime);
  }
  .case-hooks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }
  .case-hook {
    font-family: var(--font-display);
    font-stretch: 106%;
    font-weight: 620;
    font-size: var(--text-lg);
    line-height: 1.3;
    letter-spacing: -0.01em;
    padding-left: 1.25rem;
    border-left: 4px solid var(--color-lime);
    text-wrap: pretty;
  }
  .case-diagram {
    margin: 4rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }
  .case-intro {
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }
  .case-sections {
    margin-top: 5rem;
    padding-top: 1.5rem;
    border-top: 2px solid var(--color-paper);
  }
  .case-section {
    margin-top: 3.5rem;
    scroll-margin-top: 6rem;
  }
  .case-origin {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-steel);
  }
  /* Long single words (SKATEDOWNHILLS, ENGINEERING) at wdth 125 outgrow the column
     at the --text-4xl size, on phones and even at 1280px (#52). The title never gets
     bigger than --text-4xl, and shrinks just enough that its longest word fits the
     header (uppercase Archivo here runs at most ~0.92em per letter, so 0.95 leaves
     room). Short titles keep --text-4xl. overflow-wrap is the last resort, for a
     word of unusually wide letters: it breaks rather than scroll the page sideways. */
  .case-head {
    container-type: inline-size;
  }
  .case-title {
    font-size: min(var(--text-4xl), 9.5vw);
    font-size: min(var(--text-4xl), 100cqi / (var(--longest, 8) * 0.95));
    overflow-wrap: anywhere;
    hyphens: auto;
  }
  .case-nav {
    display: grid;
    /* minmax(0, …): a long title must wrap inside its column, not widen it. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    margin-top: 5rem;
    padding-top: 1.5rem;
  }
  .case-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
    overflow-wrap: anywhere;
    hyphens: auto;
    color: inherit;
    text-decoration: none;
  }
  .case-nav-link:hover .display-narrow {
    color: var(--color-lime);
  }
</style>
