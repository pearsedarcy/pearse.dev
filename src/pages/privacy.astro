---
/**
 * /privacy/ (#129). Plain page on the normal layout: indexable, in the sitemap, default Open Graph
 * card. The contact address is always `SITE.email`. The analytics paragraph renders only while
 * `SITE.analyticsToken` is set, so the page and the beacon (added by #20) change together; this page
 * does not render the beacon. The legal-basis wording is a legal claim and needs the owner's read.
 */
import Base from '../layouts/Base.astro';
import SectionLabel from '../components/SectionLabel.astro';
import { SITE } from '../lib/site';
import { ADDRESS_URI } from '../lib/mailto';

const analytics = typeof SITE.analyticsToken === 'string' && SITE.analyticsToken !== '';
---

<Base title="Privacy" description="What this site and the services that host it process when you visit, and who to write to about your data.">
  <article class="wrap pt-10 md:pt-16">
    <header class="max-w-[52rem]">
      <SectionLabel n="00" text="Privacy" />
      <h1 class="display-narrow text-4xl mt-5">Privacy</h1>
      <p class="mt-6 text-steel">
        This is a static website. It has no accounts and no database. The contact form on the home page only opens your own mail app
        (or copies your text); nothing you type into it is sent to this site. The only personal data involved is what the services
        that deliver it process when you visit.
      </p>
    </header>

    <div class="prose prose-site mt-12 md:mt-16">
      <h2>Who processes what</h2>
      <h3>GitHub Pages (hosting)</h3>
      <p>
        The site is hosted on GitHub Pages. GitHub receives every request, including your IP address, and keeps logs for security and
        abuse handling. See <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" rel="noopener">GitHub’s privacy statement</a>.
      </p>
      <h3>Cloudflare (proxy, CDN and firewall)</h3>
      <p>
        Requests pass through Cloudflare. It sees every request, including your IP address, to serve the site and to protect it from
        abuse. See <a href="https://www.cloudflare.com/privacypolicy/" rel="noopener">Cloudflare’s privacy policy</a>.
      </p>
      <p>
        The legal basis for both is legitimate interest (Article 6(1)(f) GDPR): delivering a website and keeping it secure.
      </p>
      <h3>Email</h3>
      <p>
        If you write to <a href={ADDRESS_URI}>{SITE.email}</a>, the message stays in my mailbox and is used only to reply to you.
      </p>

      {
        analytics && (
          <>
            <h3>Analytics</h3>
            <p>
              The site uses Cloudflare Web Analytics to count page views. It sets no cookies and builds no profile of you. I see
              aggregate page views only.
            </p>
          </>
        )
      }

      <h2>What this site does not do</h2>
      <ul>
        <li>It sets no cookies.</li>
        <li>It uses no local storage.</li>
        {analytics ? <li>It loads no third-party fonts or embeds.</li> : <li>It loads no third-party scripts, fonts or embeds. Fonts are served from this site.</li>}
      </ul>

      <h2>Your rights</h2>
      <p>
        You can ask for access to, correction of, or deletion of your data, and object to its processing. This site holds none of its
        own beyond any email you send me. To ask, write to <a href={ADDRESS_URI}>{SITE.email}</a>. For what GitHub and Cloudflare
        hold, write to them using the policies linked above. You may also complain to your data protection authority.
      </p>
    </div>
  </article>
</Base>
