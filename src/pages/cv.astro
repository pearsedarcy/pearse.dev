---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionLabel from '../components/SectionLabel.astro';
import { getVisibleProjects } from '../lib/projects';
import CopyEmail from '../components/CopyEmail.astro';
import { INTERESTS, SITE, absoluteUrl } from '../lib/site';
import SkillMatrix from '../components/SkillMatrix.astro';
import { getSkillGroups } from '../lib/skills';
import { limitRows } from '../lib/skill-map';
import { buildMailto } from '../lib/mailto';
import { twoDigit } from '../lib/work-order';
import { featuredQuotes } from '../lib/quotes';
import ClientQuote from '../components/ClientQuote.astro';

// Facts that exist nowhere else live in src/content/cv/cv.md; everything else is derived
// from the site, so the CV cannot drift from the case studies. Pending client case studies
// are excluded by getVisibleProjects().
const entry = await getEntry('cv', 'cv');
if (!entry) throw new Error('src/content/cv/cv.md is missing');
const { Content } = await render(entry);
const { headline, experience, education, before, languages } = entry.data;
// Featured plus MTS platforms: hobby and learning repos stay on /work/, not on the CV.
const projects = (await getVisibleProjects()).filter((p) => p.data.featured || p.data.category === 'mts');
// Up to two granted client quotes in /work/ order (#279), from every case study, not only the
// ones listed above; none renders no section and takes no section number.
const quotes = featuredQuotes((await getVisibleProjects()).map((p) => p.data));

// Skills: the first CV_SKILLS evidenced skills in skill-list (positioning) order, grouped, with
// counts, each count's earliest start year ("×4 · since 2024", #274), and no links or periods, so
// the block stays print-sized (#163).
const CV_SKILLS = 24;
const skills = limitRows(await getSkillGroups(), CV_SKILLS);

/** Start of a period only ("Jul – Oct 2026" -> "Jul 2026"); end dates are not confirmed. */
const start = (period: string) => {
  const [from, to] = period.split(/\s+–\s+/);
  if (!to || /\d{4}/.test(from)) return from;
  return `${from} ${to.match(/\d{4}/)?.[0] ?? ''}`.trim();
};

/** URL as printed on paper: no scheme, no www. */
const bare = (url: string) => url.replace(/^https?:\/\//, '').replace(/^www\./, '');

const contacts = [
  { href: buildMailto('cv').href, text: SITE.email, copy: true },
  { href: `${SITE.url}/`, text: bare(SITE.url) },
  { href: SITE.github, text: bare(SITE.github) },
  { href: SITE.linkedin, text: bare(SITE.linkedin) },
];

let n = 0;
const next = () => twoDigit(++n);
---

<Base
  title="CV"
  description="CV of Pearse D’Arcy, software engineer in Innsbruck: experience, case studies, skills, education and the downhill skateboarding career before software."
>
  <article class="cv wrap pt-10 md:pt-16">
    <header class="cv-head">
      <div class="cv-id">
        <div class="cv-screen"><SectionLabel n="00" text="CV" /></div>
        <h1 class="cv-name display">{SITE.name}</h1>
        <p class="cv-headline">{headline}</p>
      </div>
      <div class="cv-aside">
        <ul class="cv-contact" aria-label="Contact">
          {
            contacts.map((c) => (
              <li class={c.copy ? 'cv-mail' : undefined}>
                <a class="link inline-block py-0.5 -my-0.5" href={c.href}>{c.text}</a>
                {c.copy && <span class="cv-screen"><CopyEmail /></span>}
              </li>
            ))
          }
          <li class="text-steel">{SITE.location}</li>
        </ul>
        {/* The link is plain HTML; scripts/cv-pdf.mjs removes it from dist/ when no PDF was built. */}
        <div class="cv-actions cv-screen">
          <a class="btn btn-lime cv-screen" href="/pearse-darcy-cv.pdf" download="pearse-darcy-cv.pdf" data-cv-pdf>Download PDF</a>
          <button type="button" class="btn cv-screen" data-cv-print hidden>Print</button>
        </div>
      </div>
    </header>

    <section class="cv-section" aria-labelledby="cv-profile">
      <h2 id="cv-profile" class="label cv-label"><b>{next()}</b><span aria-hidden="true">—</span>Profile</h2>
      <div class="cv-profile">
        <Content />
      </div>
    </section>

    <section class="cv-section" aria-labelledby="cv-experience">
      <h2 id="cv-experience" class="label cv-label"><b>{next()}</b><span aria-hidden="true">—</span>Experience</h2>
      {
        experience.map((job) => (
          <div class="cv-row">
            <p class="cv-period">{job.period}</p>
            <div>
              <h3 class="cv-title">
                {job.title}, {job.organisation}
                {job.location && <>{' '}<span class="cv-meta">· {job.location}</span></>}
              </h3>
              {job.summary && <p class="cv-summary">{job.summary}</p>}
              {/* Job-wide bullets first, so they never read as part of the last product. */}
              {job.bullets.length > 0 && (
                <ul class="cv-bullets">
                  {job.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              )}
              {job.products.map((p) => (
                <div class="cv-product">
                  <h4 class="cv-product-name">{p.name}</h4>
                  {p.summary && <p class="cv-summary">{p.summary}</p>}
                  <ul class="cv-bullets">
                    {p.bullets.map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </section>

    <section class="cv-section" aria-labelledby="cv-work">
      <h2 id="cv-work" class="label cv-label"><b>{next()}</b><span aria-hidden="true">—</span>Case studies</h2>
      <ul class="cv-work">
        {
          projects.map((p) => (
            <li class="cv-row">
              <p class="cv-period">{start(p.data.period)}</p>
              <div>
                <h3 class="cv-title">
                  <a class="link inline-block py-0.5 -my-0.5" href={`/work/${p.data.slug}/`} data-print-url={bare(absoluteUrl(`/work/${p.data.slug}/`))}>
                    {p.data.title}
                  </a>
                </h3>
                <p class="cv-summary">{p.data.oneLiner}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="cv-section" aria-labelledby="cv-skills">
      <h2 id="cv-skills" class="label cv-label"><b>{next()}</b><span aria-hidden="true">—</span>Skills</h2>
      <div class="cv-skills"><SkillMatrix groups={skills} showSince /></div>
    </section>

    <section class="cv-section" aria-labelledby="cv-education">
      <h2 id="cv-education" class="label cv-label"><b>{next()}</b><span aria-hidden="true">—</span>Education</h2>
      {
        education.map((e) => (
          <div class="cv-row">
            <p class="cv-period">{e.period}</p>
            <div>
              <h3 class="cv-title">
                {e.title}, {e.organisation}
              </h3>
              {e.summary && <p class="cv-summary">{e.summary}</p>}
              <ul class="cv-bullets">
                {e.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </section>

    {
      before.length > 0 && (
        <section class="cv-section" aria-labelledby="cv-before">
          <h2 id="cv-before" class="label cv-label">
            <b>{next()}</b>
            <span aria-hidden="true">—</span>Before software
          </h2>
          {before.map((e) => (
            <div class="cv-row">
              <p class="cv-period">{e.period}</p>
              <div>
                <h3 class="cv-title">
                  {e.title}, {e.organisation}
                </h3>
                {e.summary && <p class="cv-summary">{e.summary}</p>}
                <ul class="cv-bullets">
                  {e.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </section>
      )
    }

    {
      languages.length > 0 && (
        <section class="cv-section" aria-labelledby="cv-languages">
          <h2 id="cv-languages" class="label cv-label">
            <b>{next()}</b>
            <span aria-hidden="true">—</span>Languages
          </h2>
          <ul class="cv-languages">
            {languages.map((l) => (
              <li>
                {l.language} <span class="cv-meta">· {l.level}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="cv-section" aria-labelledby="cv-interests">
      <h2 id="cv-interests" class="label cv-label"><b>{next()}</b><span aria-hidden="true">—</span>Interests</h2>
      <ul class="cv-interests" aria-label="Interests">
        {INTERESTS.map((i) => <li>{i}</li>)}
      </ul>
    </section>

    {
      /* Last, so in print it uses page two's spare room and never pushes a kept-whole row over a break. */
      quotes.length > 0 && (
        <section class="cv-section cv-quotes-section" aria-labelledby="cv-quotes">
          <h2 id="cv-quotes" class="label cv-label">
            <b>{next()}</b>
            <span aria-hidden="true">—</span>From clients
          </h2>
          <ul class="cv-quotes">
            {quotes.map(({ project, quote }) => (
              <li class="cv-quote">
                <ClientQuote
                  quote={quote}
                  compact
                  caseStudy={{ href: `/work/${project.slug}/`, title: project.title }}
                />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Base>

<script>
  // Progressive enhancement: the button only appears when it can do something.
  document.querySelectorAll<HTMLButtonElement>('[data-cv-print]').forEach((btn) => {
    btn.hidden = false;
    btn.addEventListener('click', () => window.print());
  });
</script>

<style>
  .cv-head {
    display: grid;
    gap: 2rem;
    padding-bottom: 2.5rem;
    border-bottom: 2px solid var(--color-paper);
  }
  @media (min-width: 64rem) {
    .cv-head {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }
  }
  .cv-name {
    margin-top: 1.25rem;
    font-size: clamp(2.5rem, 1rem + 6vw, 6rem);
    overflow-wrap: anywhere;
  }
  /* Layout shift (#153): at 125% stretch Archivo is wider than its fallback, so the name wraps
     to two lines at up to about 505px and 1024-1380px where the fallback still fits on one, and
     the swap pushed the contact block down (CLS 0.03 on /cv/). Reserve the second line
     (2 x the .display line-height of 0.86) in those bands, with a margin either side, so the
     swap moves nothing. Screen only: print sets its own size. */
  @media screen and (max-width: 33rem), screen and (min-width: 64rem) and (max-width: 88rem) {
    .cv-name {
      min-height: 1.72em;
    }
  }
  .cv-headline {
    margin-top: 1.5rem;
    max-width: 52ch;
    font-size: var(--text-lg);
    line-height: 1.45;
  }
  .cv-aside {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .cv-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .cv-contact {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
  }
  .cv-mail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
  }
  .cv-section {
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }
  .cv-label {
    display: flex;
    margin-bottom: 1rem;
  }
  .cv-work,
  .cv-languages,
  .cv-bullets {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cv-row {
    display: grid;
    gap: 0.4rem 2rem;
    padding-block: 1.1rem;
    border-top: 1px solid var(--color-line);
  }
  @media (min-width: 48rem) {
    .cv-row {
      grid-template-columns: 11rem minmax(0, 1fr);
    }
  }
  .cv-period {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-lime);
    padding-top: 0.3rem;
  }
  .cv-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 112%;
    font-size: var(--text-lg);
    line-height: 1.3;
  }
  .cv-meta {
    margin-left: 0.35em;
  }
  /* The job line carries a real text space before the separator (copy-paste, screen readers). */
  .cv-title .cv-meta {
    margin-left: 0;
  }
  .cv-meta {
    font-family: var(--font-sans);
    font-weight: 400;
    font-stretch: 100%;
    font-size: var(--text-sm);
    color: var(--color-steel);
  }
  .cv-summary {
    margin-top: 0.35rem;
    max-width: 72ch;
    color: var(--color-steel);
  }
  .cv-bullets {
    margin-top: 0.6rem;
    display: grid;
    gap: 0.45rem;
    max-width: 72ch;
  }
  .cv-bullets li {
    position: relative;
    padding-left: 1.1rem;
  }
  .cv-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.4rem;
    height: 2px;
    background: var(--color-lime);
  }
  .cv-profile {
    display: grid;
    gap: 1rem;
    max-width: 64ch;
    font-size: var(--text-lg);
    line-height: 1.5;
  }
  .cv-languages {
    display: grid;
    gap: 0.4rem;
  }
  .cv-product {
    margin-top: 0.9rem;
  }
  .cv-product-name {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  /* One line, dot-separated: a list for screen readers, a sentence on paper. */
  .cv-interests {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    max-width: 72ch;
  }
  .cv-quotes {
    display: grid;
    gap: 1rem;
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
  }
  .cv-interests li + li::before {
    content: '·';
    margin-inline: 0.5em;
    color: var(--color-lime);
  }

  /* Print: A4, black on white, no chrome, links spelled out, entries kept whole. */
  @media print {
    @page {
      size: A4;
      margin: 13mm 15mm;
    }
    :global(html),
    :global(body) {
      background: #fff !important;
      color: #000 !important;
      font-size: 8.6pt;
    }
    /* The fixed grain overlay (global.css) prints as a page-sized raster on every page:
       ~2.4 MB of the PDF and grey speckle on paper. */
    :global(body)::after {
      display: none !important;
    }
    :global(body > header),
    :global(body > footer),
    :global(body > a[href='#main']),
    .cv-screen {
      display: none !important;
    }
    .cv {
      max-width: none;
      padding: 0 !important;
    }
    .cv :global(*) {
      color: #000 !important;
      border-color: #000 !important;
      background: transparent !important;
      box-shadow: none !important;
    }
    .cv a {
      text-decoration: none;
    }
    .cv a[data-print-url]::after {
      content: ' — ' attr(data-print-url);
      font-family: var(--font-mono);
      font-weight: 400;
      font-stretch: 100%;
      font-size: 0.8em;
    }
    .cv-head {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 1.5rem;
      padding-bottom: 0.8rem;
    }
    .cv-name {
      margin-top: 0;
      font-size: 26pt;
    }
    .cv-headline {
      margin-top: 0.5rem;
      font-size: 10pt;
    }
    .cv-contact {
      gap: 0.1rem;
      font-size: 8pt;
    }
    .cv-section {
      margin-top: 1.1rem;
    }
    .cv-label {
      margin-bottom: 0.25rem;
      break-after: avoid;
    }
    /* Client quotes (#279): compact, and a quote never splits across the page break. The section
       sits last and page two has little room, so the caption runs on after the words. */
    .cv-quotes-section {
      display: grid;
      grid-template-columns: 7.5rem minmax(0, 1fr);
      gap: 0 1rem;
      margin-top: 0.6rem;
      break-inside: avoid;
    }
    .cv-quotes-section .cv-label {
      margin: 0;
    }
    .cv-quotes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 1.25rem;
      margin-top: 0;
    }
    .cv-quote {
      break-inside: avoid;
    }
    .cv-quote :global(.client-quote),
    .cv-quote :global(blockquote),
    .cv-quote :global(blockquote p),
    .cv-quote :global(figcaption) {
      display: inline;
      margin: 0;
      padding: 0;
      border: 0;
    }
    .cv-quote :global(blockquote p) {
      font-size: 7.5pt;
      line-height: 1.3;
    }
    .cv-quote :global(figcaption) {
      margin-left: 0.4em;
      font-size: 6pt;
      letter-spacing: 0.06em;
    }
    /* The link's screen tap padding would overflow the last line onto a blank page. */
    .cv-quote :global(a) {
      display: inline;
      margin: 0;
      padding: 0;
      text-decoration: none;
    }
    .cv-row {
      grid-template-columns: 7.5rem minmax(0, 1fr);
      gap: 0 1rem;
      padding-block: 0.45rem;
      break-inside: avoid;
    }
    .cv-period {
      font-size: 7pt;
      padding-top: 0.15rem;
    }
    .cv-title {
      font-size: 9.5pt;
      break-after: avoid;
    }
    .cv-meta {
      font-size: 8pt;
    }
    .cv-summary {
      margin-top: 0.1rem;
      max-width: none;
    }
    .cv-bullets {
      margin-top: 0.25rem;
      gap: 0.15rem;
      max-width: none;
    }
    .cv-bullets li::before {
      background: #000 !important;
      top: 0.65em;
    }
    .cv-interests li + li::before {
      color: #000 !important;
    }
    .cv-product {
      margin-top: 0.35rem;
      break-inside: avoid;
    }
    .cv-product-name {
      font-size: 7.5pt;
      break-after: avoid;
    }
    .cv-interests {
      max-width: none;
    }
    .cv-profile {
      gap: 0.35rem;
      max-width: none;
      font-size: 9pt;
    }
    /* On paper the skills matrix runs as one paragraph: "BACKEND Django ×5 · since 2024 Python ×2 · since 2025 · DATA …". */
    .cv-skills {
      font-size: 8pt;
      line-height: 1.45;
    }
    .cv-skills :global(.skill-matrix),
    .cv-skills :global(.skill-matrix-group),
    .cv-skills :global(.skill-matrix-list),
    .cv-skills :global(.skill-matrix-item) {
      display: inline;
      padding: 0;
      border: 0;
      font-size: inherit;
    }
    .cv-skills :global(.skill-matrix-label) {
      display: inline;
      margin-right: 0.35em;
      font-size: 6.5pt;
      color: #000 !important;
    }
    /* Items wrap between each other; the generated spaces are the break points. */
    .cv-skills :global(.skill-matrix-item) {
      white-space: normal;
    }
    .cv-skills :global(.skill-matrix-item + .skill-matrix-item)::before,
    .cv-skills :global(.skill-matrix-group + .skill-matrix-group)::before {
      content: ' ';
      white-space: normal;
    }
    .cv-skills :global(.skill-matrix-group + .skill-matrix-group)::before {
      content: ' · ';
    }
  }
</style>
