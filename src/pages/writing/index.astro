---
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import { getPublishedPosts } from '../../lib/posts';
import { countNoun } from '../../lib/count-label';

const posts = await getPublishedPosts();
const count = countNoun(posts.length, 'post');
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<Base title="Writing" description="Notes on building Django platforms, running self-hosted AI in production, and engineering with agents.">
  <section class="wrap pt-10 md:pt-16">
    <p class="label"><b>{count.n}</b>{" "}{count.noun}<span aria-hidden="true">/</span><a class="inline-block py-2 -my-2 hover:text-lime" href="/rss.xml">RSS</a></p>
    <h1 class="display text-4xl mt-5" data-split>Writing</h1>
    <p class="mt-6 text-lg text-steel max-w-[52ch]">
      Decisions, numbers and the things that went wrong. Platform building, self-hosted AI, and agent workflows that
      ship.
    </p>
    {
      tags.length > 0 && (
        <ul class="topics mt-8" aria-label="Topics">
          {tags.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      )
    }
  </section>

  <section class="wrap mt-14 md:mt-20" aria-label="All posts">
    {
      posts.length ? (
        <div>{posts.map((post) => <PostRow post={post} level={2} />)}</div>
      ) : (
        <p class="text-steel">Nothing published yet.</p>
      )
    }
  </section>
</Base>

<style>
  /* The Topics row is plain metadata, not a filter (#299): no border, padding or pointer, so it
     does not read as a row of buttons. A middle dot separates the items; the alt text "" keeps
     screen readers from announcing it where `content: x / alt` is supported. */
  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.6rem;
    list-style: none;
    margin-inline: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--color-steel);
  }
  .topics li + li::before {
    content: '\00b7';
    content: '\00b7' / '';
    margin-right: 0.6rem;
  }
</style>
