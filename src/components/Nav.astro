---
import { NAV } from '../lib/site';
const path = Astro.url.pathname;
const isCurrent = (href: string) => !href.includes('#') && path.startsWith(href);
---

<header class="wrap flex items-center justify-between gap-6 py-5 md:py-6">
  <a href="/" class="font-mono text-sm font-semibold tracking-tight text-paper hover:text-lime" aria-label="pearse.dev home">
    pearse<span class="text-lime">.</span>dev
  </a>
  <nav aria-label="Primary">
    <ul class="flex items-center gap-5 md:gap-8">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class="font-mono text-xs uppercase tracking-[0.14em] text-steel hover:text-paper aria-[current=page]:text-paper aria-[current=page]:underline aria-[current=page]:decoration-lime aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-6"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <span class="hidden lg:block font-mono text-xs tracking-[0.14em] text-steel" aria-hidden="true">47.27°N 11.39°E</span>
</header>
