---
import { getMarqueeWords } from '../lib/skills';

// A word links to its /stack/ row when its skill has evidence (#163); otherwise it stays plain text.
// Only the first copy's links take focus: the second copy is aria-hidden, so its links get tabindex -1.
const words = await getMarqueeWords();
---

<div class="marquee" role="presentation">
  <div class="marquee-track">
    {
      [0, 1].map((copy) => (
        <ul class="marquee-list" aria-hidden={copy === 1 ? 'true' : undefined}>
          {words.map(({ word, row }) => (
            <li class="marquee-item">
              {row ? (
                <a class="marquee-link" href={`/stack/#${row.anchor}`} tabindex={copy === 1 ? '-1' : undefined}>
                  {word}
                </a>
              ) : (
                <span>{word}</span>
              )}
              <span class="marquee-sep" aria-hidden="true">/</span>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<script>
  // Keyboard focus stops the drift (CSS: .marquee:focus-within) and the container's own scroll position
  // brings the focused link on screen; leaving the band restores the start so the drift resumes from 0 (#301).
  for (const marquee of document.querySelectorAll<HTMLElement>('.marquee')) {
    marquee.addEventListener('focusin', (event) => {
      if (event.target instanceof HTMLElement) event.target.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    });
    marquee.addEventListener('focusout', (event) => {
      if (!(event.relatedTarget instanceof Node) || !marquee.contains(event.relatedTarget)) marquee.scrollLeft = 0;
    });
  }
</script>

<style>
  .marquee-list {
    display: flex;
    flex-shrink: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .marquee-item {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    padding: 0.9rem 0 0.9rem 1.5rem;
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 740;
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }
  /* A 28px-tall target with an equal negative margin, so the band keeps its height (WCAG 2.5.8). */
  .marquee-link {
    display: inline-block;
    padding-block: 0.25rem;
    margin-block: -0.25rem;
    color: inherit;
    text-decoration: none;
  }
  .marquee-link:hover {
    color: var(--color-lime);
  }
  .marquee-link:focus-visible {
    outline: 2px solid var(--color-lime);
    outline-offset: 4px;
  }
  .marquee-sep {
    color: var(--color-lime);
    font-weight: 400;
  }
  /*
   * Reduced motion (#269): the same words and links, as a static wrapped list. These rules sit here,
   * after the base rules, because the list rules above compile to unlayered `.marquee-list[data-astro-cid-*]`
   * (0,2,0); a global override in any @layer, or a bare global `.marquee-list`, would lose to them.
   * The track's own width/display is reset in global.css. The duplicate copy only makes the loop seamless.
   */
  @media (prefers-reduced-motion: reduce) {
    .marquee-list {
      flex-wrap: wrap;
      flex-shrink: 1;
      width: 100%;
    }
    .marquee-list[aria-hidden='true'] {
      display: none;
    }
  }
</style>
