---
/**
 * The arc, oldest first, derived from src/content/cv/cv.md by timelineRows() (#168), so the
 * Timeline and /cv/ read the same entries. The orange "now" marker follows the CV's
 * `timeline.now` flag, not the last row. Products are sub-items in a <div> of <p>s after the
 * three spans: no nested <li> or <span>, which the bio tests' row and title reads rely on.
 */
import { getEntry } from 'astro:content';
import { timelineRows } from '../lib/timeline';

const entry = await getEntry('cv', 'cv');
if (!entry) throw new Error('src/content/cv/cv.md is missing');
const rows = timelineRows(entry.data);
---

<ol class="timeline" aria-label="Timeline">
  {
    rows.map((r) => (
      <li class:list={['timeline-row', r.now && 'timeline-now']}>
        <span class="font-mono text-xs uppercase tracking-[0.12em] text-lime">{r.period}</span>
        <span class="text-sm text-steel">{r.href ? <a class="link inline-block py-1 -my-1" href={r.href}>{r.context}</a> : r.context}</span>
        <span class="text-base">{r.headline}</span>
        {r.products.length > 0 && (
          <div class="timeline-products">
            {r.products.map((p) => (
              <p class="text-sm text-steel">
                <strong class="font-medium text-paper">{p.name}</strong> {p.headline}
              </p>
            ))}
          </div>
        )}
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
