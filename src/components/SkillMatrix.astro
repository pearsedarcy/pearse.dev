---
import type { SkillGroup } from '../lib/skill-map';

// The compact skills matrix (#163): one line per group, each skill with the number of case studies
// that name it. Home links each skill to its /stack/ row; the CV renders it unlinked for print and
// adds the earliest case study's start year ("×4 · since 2024", #274).
interface Props {
  groups: SkillGroup[];
  /** Link each skill to its row on /stack/. */
  linked?: boolean;
  /** Add " · since YYYY" (the row's `earliest`) to each count. Off by default: home stays a teaser. */
  showSince?: boolean;
  class?: string;
}
const { groups, linked = false, showSince = false, class: cls = '' } = Astro.props;
// With since, the name keeps its count by a no-break space and the item may wrap inside the count,
// so a longer item never pushes a 360 px screen sideways.
const gap = showSince ? '\u00a0' : ' ';
const count = (r: SkillGroup['rows'][number]) => (showSince ? `×${r.count} · since ${r.earliest}` : `×${r.count}`);
---

<div class:list={['skill-matrix', cls]} data-skill-matrix>
  {
    groups.map((g) => (
      <div class="skill-matrix-group">
        <p class="skill-matrix-label">{g.name}</p>
        <ul class="skill-matrix-list">
          {g.rows.map((r) => (
            <li class:list={['skill-matrix-item', { 'skill-matrix-wrap': showSince }]} data-skill={r.name}>
              {linked ? (
                <a class="skill-matrix-link" href={`/stack/#${r.anchor}`}>
                  {r.name}{gap}<span class="skill-count">{count(r)}</span>
                </a>
              ) : (
                <>
                  {r.name}{gap}<span class="skill-count">{count(r)}</span>
                </>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .skill-matrix {
    display: grid;
    gap: 0;
  }
  .skill-matrix-group {
    display: grid;
    gap: 0.4rem 1.5rem;
    padding-block: 0.7rem;
    border-top: 1px solid var(--color-line);
  }
  @media (min-width: 48rem) {
    .skill-matrix-group {
      grid-template-columns: 7rem minmax(0, 1fr);
      align-items: baseline;
    }
  }
  .skill-matrix-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-lime);
  }
  .skill-matrix-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  .skill-matrix-item {
    white-space: nowrap;
  }
  .skill-matrix-item.skill-matrix-wrap {
    white-space: normal;
  }
  .skill-matrix-link {
    display: inline-block;
    padding-block: 0.15rem;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--color-line);
    text-underline-offset: 0.2em;
  }
  .skill-matrix-link:hover {
    text-decoration-color: var(--color-lime);
  }
  .skill-count {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--color-steel);
  }
</style>
