---
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingTime } from '../lib/site';
import { postPath } from '../lib/posts';

interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const minutes = readingTime(post.body ?? '');
---

<a href={postPath(post)} class="post-row">
  <time datetime={post.data.pubDate.toISOString()} class="post-date">{formatDate(post.data.pubDate)}</time>
  <div class="post-main">
    <h3 class="display-narrow text-xl">{post.data.title}</h3>
    <p class="post-desc">{post.data.description}</p>
    <ul class="post-tags" aria-label="Tags">
      {post.data.tags.map((t) => <li class="chip">{t}</li>)}
    </ul>
  </div>
  <span class="post-time">{minutes} min</span>
</a>

<style>
  .post-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem 2rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--color-line);
    color: inherit;
    text-decoration: none;
  }
  .post-row:last-child {
    border-bottom: 1px solid var(--color-line);
  }
  @media (min-width: 48rem) {
    .post-row {
      grid-template-columns: 9rem 1fr 5rem;
      align-items: start;
    }
    .post-time {
      text-align: right;
    }
  }
  .post-date,
  .post-time {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-steel);
    padding-top: 0.35rem;
  }
  .post-main {
    display: grid;
    gap: 0.6rem;
  }
  .post-desc {
    color: var(--color-steel);
    font-size: var(--text-sm);
    max-width: 62ch;
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
  }
  @media (hover: hover) {
    .post-row:hover h3 {
      color: var(--color-lime);
    }
  }
</style>
